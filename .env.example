# URL del backend Escolar (puerto 8080 en local, ngrok en deploy)
NEXT_PUBLIC_API_URL=http://localhost:8080

# false = conectar al back real; true = datos de ejemplo sin back (solo maquetar)
NEXT_PUBLIC_USAR_MOCK=false

# Dominio ngrok del front (solo si usas ngrok para el front)
NGROK_DOMAIN_FRONT=<tu-dominio-front>.ngrok-free.app

# Token de autenticación de ngrok (obtener en https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=<tu-authtoken-ngrok>